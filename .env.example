# SecureFin Gateway — ejemplo de configuración (T012). SIN VALORES REALES.
# Los secretos NO van aquí: se generan como archivos en secrets/ (ignorado por git).
# Ver docs/security/secrets.md.

ALLOWED_HOSTS=securefin.local
FRONTEND_BASE_URL=https://securefin.local
CSRF_TRUSTED_ORIGIN=https://securefin.local

# Versiones aceptadas de cada conjunto de claves; la primera es la activa (R8)
SESSION_HMAC_KEY_VERSIONS=v1
TOKEN_HMAC_KEY_VERSIONS=v1
THROTTLE_HMAC_KEY_VERSIONS=v1
TOTP_KEY_VERSIONS=v1

# Solo para pruebas E2E y del stack (valores efímeros generados en el momento; U2)
# MAILPIT_API_USER=
# MAILPIT_API_PASSWORD=
# SECUREFIN_STACK_URL=https://securefin.local
